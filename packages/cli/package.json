{
  "name": "@code-analyzer/cli",
  "version": "0.0.0",
  "description": "Thin CLI adapter around @code-analyzer/core. Contains no analysis logic — only argument parsing, output formatting, and wiring to AnalyzerClient.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codegraph-scan": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@code-analyzer/core": "workspace:*",
    "@code-analyzer/project-model": "workspace:*",
    "@code-analyzer/graph": "workspace:*",
    "@code-analyzer/analyzers": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}
