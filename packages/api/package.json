{
  "name": "@code-analyzer/api",
  "version": "0.0.0",
  "description": "HTTP API exposing @code-analyzer/core's AnalyzerClient/ScanEngine pipeline: upload a code archive, run the same analysis the CLI runs, return a ScanResult (optionally streamed over SSE). Contains no analysis logic of its own.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codegraph-api": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@code-analyzer/core": "workspace:*",
    "@code-analyzer/project-model": "workspace:*",
    "@code-analyzer/graph": "workspace:*",
    "@code-analyzer/analyzers": "workspace:*",
    "@code-analyzer/integrations": "workspace:*",
    "fastify": "^5.2.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0",
    "@types/yauzl": "^2.10.3"
  }
}
