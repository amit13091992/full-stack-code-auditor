{
  "name": "codegraph-scan",
  "version": "1.0.8",
  "type": "module",
  "description": "Application-aware full-stack codebase analyzer — repository discovery, JS/TS/Python parsing, Module/Symbol/Call graphs, and built-in architecture/quality/secrets analyzers (Phase 4 complete)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "bin": {
    "codegraph-scan": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "bundle": "esbuild packages/cli/dist/bin.js --bundle --platform=node --target=node20 --format=esm --outfile=dist/cli.js --external:tree-sitter --external:tree-sitter-python --external:typescript && chmod +x dist/cli.js",
    "prepublishOnly": "pnpm run build && pnpm run bundle",
    "clean": "pnpm -r run clean && rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "serve:api": "pnpm --filter @code-analyzer/api run start"
  },
  "dependencies": {
    "tree-sitter": "^0.25.1",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yazl": "^3.3.1",
    "@types/yazl": "^3.3.1"
  }
}
